    public static class InteractionPlayerControllerPatch
    {
        const int MaxPacks = 24;
        const int PacksPerColumn = 12;

        [HarmonyPatch(typeof(InteractionPlayerController), "Awake")]
        [HarmonyPostfix]
        public static void AwakePostfix(InteractionPlayerController __instance)
        {

            if (__instance.m_HoldCardPackPosList == null)
                return;

            while (__instance.m_HoldCardPackPosList.Count < MaxPacks)
            {
                Transform lastTransform = __instance.m_HoldCardPackPosList.Last();
                Vector3 newPosition = lastTransform.localPosition;

                if (__instance.m_HoldCardPackPosList.Count >= PacksPerColumn)
                {
                    // Seconde Colonne
                    newPosition.x = -0.07f;
                    newPosition.z = __instance.m_HoldCardPackPosList[__instance.m_HoldCardPackPosList.Count % PacksPerColumn].localPosition.z;
                }
                else
                {
                    newPosition.z -= 0.02f;
                }

                GameObject newPackPos = new GameObject($"CardPackPos_{__instance.m_HoldCardPackPosList.Count}");
                newPackPos.transform.SetParent(lastTransform.parent);
                newPackPos.transform.localPosition = newPosition;
                newPackPos.transform.localRotation = lastTransform.localRotation;
                newPackPos.transform.localScale = Vector3.one; // Echelle des packs (1, 1, 1)

                __instance.m_HoldCardPackPosList.Add(newPackPos.transform);
            }

            // Position final des packs
            for (int i = 0; i < __instance.m_HoldCardPackPosList.Count; i++)
            {
                Transform packTransform = __instance.m_HoldCardPackPosList[i];
                Plugin.Logger.LogInfo($"Pack {i + 1} final position: {packTransform.localPosition}, rotation: {packTransform.localRotation}, scale: {packTransform.localScale}");
            }

            Plugin.Logger.LogInfo($"You can now hold: {MaxPacks} packs (in 2 columns).");
        }

        [HarmonyTranspiler]
        [HarmonyPatch(typeof(InteractionPlayerController), "EvaluateTakeItemFromShelf")]
        public static IEnumerable<CodeInstruction> EvaluateTakeItemFromShelfTranspiler(
          IEnumerable<CodeInstruction> instructions)
        {
            List<CodeInstruction> list = instructions.ToList<CodeInstruction>();
            int num = 0;
            for (int index = 0; index < list.Count; ++index)
            {
                if (list[index].opcode == OpCodes.Ldc_I4_8 && index + 1 < list.Count && list[index + 1].opcode != OpCodes.Call)
                {
                    list[index] = new CodeInstruction(OpCodes.Ldc_I4, MaxPacks);
                    ++num;
                    Plugin.Logger.LogDebug("Matching limit patched.");
                }
            }
            if (num == 2)
                Plugin.Logger.LogDebug("Success! Both limits patched.");
            else
                Plugin.Logger.LogWarning($"Warning! Expected 2 limits patched, but found {num}.");
            return list.AsEnumerable<CodeInstruction>();
        }

        [HarmonyTranspiler]
        [HarmonyPatch(typeof(InteractionPlayerController), "HasEnoughSlotToHoldCard")]
        public static IEnumerable<CodeInstruction> HasEnoughSlotToHoldCardTranspiler(
          IEnumerable<CodeInstruction> instructions)
        {
            List<CodeInstruction> list = instructions.ToList<CodeInstruction>();
            bool flag = false;
            for (int index = 0; index < list.Count; ++index)
            {
                if (list[index].opcode == OpCodes.Ldc_I4_8 && !flag)
                {
                    list[index] = new CodeInstruction(OpCodes.Ldc_I4, MaxPacks);
                    flag = true;
                    Plugin.Logger.LogDebug("Patched HasEnoughSlotToHoldCard.");
                }
            }
            return list.AsEnumerable<CodeInstruction>();
        }

        public static bool CanOpenCardBox(InteractionPlayerController __instance)
        {
            List<Item> m_HoldItemList = (List<Item>)AccessTools.Field(typeof(InteractionPlayerController), "m_HoldItemList").GetValue(__instance);
            bool flag = false;
            if (m_HoldItemList.Count > 0)
            {
                Item holdItem = m_HoldItemList[0];
                flag = holdItem.GetItemType() == EItemType.BasicCardBox || holdItem.GetItemType() == EItemType.RareCardBox || holdItem.GetItemType() == EItemType.EpicCardBox || holdItem.GetItemType() == EItemType.LegendaryCardBox || holdItem.GetItemType() == EItemType.DestinyBasicCardBox || holdItem.GetItemType() == EItemType.DestinyRareCardBox || holdItem.GetItemType() == EItemType.DestinyEpicCardBox || holdItem.GetItemType() == EItemType.DestinyLegendaryCardBox;
            }
            return flag;
        }

        // Nouvelle méthode AddHoldCard
        public static void AddHoldCard(InteractableCard3d card3d)
        {
            if (!(bool)(UnityEngine.Object)card3d)
                return;

            card3d.m_Card3dUI.m_IgnoreCulling = true;
            card3d.m_Card3dUI.m_CardUI.ResetFarDistanceCull();
            card3d.m_Card3dUI.m_CardUIAnimGrp.gameObject.SetActive(true);
            card3d.m_Card3dUI.m_CardUI.SetFoilMaterialList(CSingleton<Card3dUISpawner>.Instance.m_FoilMaterialWorldView);
            card3d.m_Card3dUI.m_CardUI.SetFoilBlendedMaterialList(CSingleton<Card3dUISpawner>.Instance.m_FoilBlendedMaterialWorldView);

            var currentHoldingCard3dListField = AccessTools.Field(typeof(InteractionPlayerController), "m_CurrentHoldingCard3dList");
            var currentHoldingCard3dList = currentHoldingCard3dListField.GetValue(CSingleton<InteractionPlayerController>.Instance) as List<InteractableCard3d>;

            var holdCardPosListField = AccessTools.Field(typeof(InteractionPlayerController), "m_HoldCardPosList");
            var holdCardPosList = holdCardPosListField.GetValue(CSingleton<InteractionPlayerController>.Instance) as List<Transform>;

            card3d.LerpToTransform(holdCardPosList[currentHoldingCard3dList.Count], holdCardPosList[currentHoldingCard3dList.Count]);

            var holdCardGrpTargetRotationField = AccessTools.Field(typeof(InteractionPlayerController), "m_HoldCardGrpTargetRotation");
            var holdCardGrpTargetRotation = (Quaternion)holdCardGrpTargetRotationField.GetValue(CSingleton<InteractionPlayerController>.Instance);

            holdCardGrpTargetRotation = Quaternion.Euler(0.0f, 0.0f, Mathf.Lerp(0.0f, 15f, (float)currentHoldingCard3dList.Count / 7f));
            holdCardGrpTargetRotationField.SetValue(CSingleton<InteractionPlayerController>.Instance, holdCardGrpTargetRotation);

            currentHoldingCard3dList.Add(card3d);
            CPlayerData.m_HoldCardDataList.Add(card3d.m_Card3dUI.m_CardUI.GetCardData());
        }

        // Nouvelle méthode RemoveToolTip
        public static void RemoveToolTip(EGameAction action)
        {
            var inputTooltipListDisplayField = AccessTools.Field(typeof(InteractionPlayerController), "m_InputTooltipListDisplay");
            var inputTooltipListDisplay = inputTooltipListDisplayField.GetValue(CSingleton<InteractionPlayerController>.Instance) as InputTooltipListDisplay;

            inputTooltipListDisplay.RemoveTooltip(action);
        }

